# Application
NODE_ENV=development
PORT=3000
APP_NAME=nestjs-boilerplate
API_PREFIX=api
API_VERSION=1
APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nestjs_boilerplate
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Redis
REDIS_URL=redis://localhost:6379
CACHE_TTL=300

# Queue (BullMQ)
QUEUE_NAME=default
QUEUE_TIMEOUT=0
QUEUE_REMOVE=true
QUEUE_ATTEMPTS=0

# Mail (SMTP)
MAIL_HOST=smtp.google.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_SECURE=false
MAIL_PREVIEW=false

# i18n
I18N_DEFAULT_LOCALE=en
I18N_SUPPORTED_LOCALES=cn,en,fr,ru,vi
I18N_QUERY_LOCALE=lang
I18N_HEADER_LOCALE=x-lang

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_BLOCK_DURATION=0

# NestJS Observe (optional)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=

# Swagger
SWAGGER_TITLE=NestJS Boilerplate API
SWAGGER_DESCRIPTION=Production-ready NestJS boilerplate with modular architecture
SWAGGER_VERSION=1.0.0
SWAGGER_PATH=api/docs
SWAGGER_ADMIN_PATH=api/docs/admin
SWAGGER_ENABLE_ADMIN=true

# CORS
CORS_ORIGIN=*
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=
CORS_EXPOSED_HEADERS=
CORS_CREDENTIALS=false
CORS_MAX_AGE=
CORS_PREFLIGHT_CONTINUE=false
CORS_OPTIONS_SUCCESS_STATUS=204