{
  "name": "nestjs-boilerplate",
  "version": "12.6.0",
  "description": "Production-ready NestJS boilerplate with modular architecture, authentication, and modern tooling.",
  "author": "VnDevTop",
  "contributors": [],
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VnDevTop/nestjs-boilerplate.git"
  },
  "bugs": {
    "url": "https://github.com/VnDevTop/nestjs-boilerplate/issues"
  },
  "homepage": "https://github.com/VnDevTop/nestjs-boilerplate#readme",
  "keywords": [
    "nestjs",
    "boilerplate",
    "typescript",
    "nodejs",
    "rest-api",
    "jwt",
    "oidc"
  ],
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "overrides": {
    "tmp": "^0.2.7",
    "undici": "^8.12.3",
    "minimatch": "^11.0.3",
    "class-validator": "^0.15.1",
    "class-transformer": "^0.5.1"
  },
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start --env-file .env",
    "start:dev": "nest start --watch --env-file .env",
    "start:debug": "nest start --debug --watch --env-file .env",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@keyv/redis": "^6.1.0",
    "@nestjs-modules/mailer": "^4.0.0",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/bull": "^12.0.0",
    "@nestjs/cache-manager": "^12.0.2",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/i18n": "^0.0.2",
    "@nestjs/observe": "^0.3.21",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/typeorm": "^12.0.2",
    "axios": "^1.21.0",
    "bullmq": "^6.5.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "keyv": "^6.1.0",
    "keyv-redis": "^1.3.4",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/mau": "^0.2.9",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "husky": "^9.1.7",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
